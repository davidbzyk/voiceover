<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required for MLX/PyTorch JIT compilation on Apple Silicon -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Required for MLX Metal compute kernels -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <!-- Required for PyInstaller frozen binaries (sidecar) -->
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
    <!-- Required for microphone recording -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- Required for webcam overlay -->
    <key>com.apple.security.device.camera</key>
    <true/>
    <!-- Required for Python sidecar's dynamic .so loading -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
